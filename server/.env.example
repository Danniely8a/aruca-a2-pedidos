# ---------------------------------------------------------------
# Copia este archivo como .env y completa tus datos.
#
# Supabase: Project Settings -> Database -> Connection string -> URI
#           (usa "Session pooler" si la app corre en otro servidor)
# DBeaver usa los mismos datos en Connection Settings.
# ---------------------------------------------------------------
DATABASE_URL=

# Seguridad
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=12h

# Puerto de la API
PORT=4000

# Impuestos y moneda (Venezuela 0.16, RD 0.18, Colombia 0.19...)
TAX_RATE=0.16
CURRENCY=$

# Origen permitido del frontend (Vite en desarrollo)
CLIENT_ORIGIN=http://localhost:5173

# Pedidos montados en la web (valores por defecto; la pantalla
# /configuracion los puede cambiar y quedan en la tabla app_config)
A2_TIPO_PEDIDO=10
A2_MODULO_PEDIDO=Pedidos
A2_LISTA_PRECIO=1
# ¿El precio de arc_inv_costos_precios ya incluye impuestos? 1 = sí
A2_PRECIO_CON_IMPUESTO=0
