# ---------------------------------------------------------------
# Copia este archivo como .env y completa tus datos.
#
# Supabase: Project Settings -> Database -> Connection string -> URI
#           (usa "Session pooler" si la app corre en otro servidor)
# DBeaver usa los mismos datos en Connection Settings.
# ---------------------------------------------------------------
DATABASE_URL=

# Seguridad
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=12h

# Puerto de la API
PORT=4000

# Impuestos y moneda (Venezuela 0.16, RD 0.18, Colombia 0.19...)
TAX_RATE=0.16
CURRENCY=$

# Origen permitido del frontend (Vite en desarrollo)
CLIENT_ORIGIN=http://localhost:5173
